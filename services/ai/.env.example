# ===== AI service configuration =====
# Copy to .env and adjust. Never commit real secrets.

# --- Service ---
AI_SERVICE_NAME=ai
AI_SERVICE_PORT=8000
AI_SERVICE_ENV=dev
AI_LOG_LEVEL=INFO
AI_LOG_FORMAT=json

# --- Upstream services (called over HTTP) ---
LEGISLATION_SERVICE_URL=http://localhost:9001
DOCUMENTS_SERVICE_URL=http://localhost:9002
EVIDENCE_SERVICE_URL=http://localhost:9003
SEARCH_SERVICE_URL=http://localhost:9004

# --- Postgres (read-only consumer of intelligence + documents schemas) ---
DATABASE_URL=postgresql://civic:civic@localhost:5432/civic_intelligence
DATABASE_POOL_SIZE=10
DATABASE_STATEMENT_TIMEOUT_MS=5000

# --- Model gateway ---
# Provider-agnostic. Configure ONE or more. The gateway routes by capability + budget.
# Default: qwen (fastest, free via ModelScope)
MODEL_GATEWAY_DEFAULT_PROVIDER=qwen
MODEL_GATEWAY_TIMEOUT_SECONDS=10
MODEL_GATEWAY_MAX_RETRIES=2
MODEL_GATEWAY_BUDGET_USD_PER_DAY=20.00

# Qwen (via ModelScope API) — default provider
QWEN_API_KEY=your-modelscope-api-key-here
QWEN_BASE_URL=https://api-inference.modelscope.ai/v1/chat/completions
QWEN_DEFAULT_MODEL=Qwen-Ambassador/Qwen3.8-Max

# OpenAI (optional fallback)
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Anthropic (optional fallback)
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=claude-3-5-haiku-latest

# --- RAG ---
RAG_TOP_K=8
RAG_MIN_SCORE=0.35
RAG_RERANK_TOP_K=4
RAG_MAX_CONTEXT_TOKENS=6000

# --- Citation validation ---
CITATION_VALIDATION_REQUIRED=true
CITATION_VALIDATION_FAIL_ON_UNSUPPORTED=true

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=civic-ai

# === Vercel deployment ===
# On Vercel, set these in the project settings (not in .env):
# - AI_SERVICE_NAME=ai
# - AI_MODEL_GATEWAY_DEFAULT_PROVIDER=qwen
# - QWEN_API_KEY=your-modelscope-api-key-here
# - QWEN_BASE_URL=https://api-inference.modelscope.ai/v1/chat/completions
# - QWEN_DEFAULT_MODEL=Qwen-Ambassador/Qwen3.8-Max
