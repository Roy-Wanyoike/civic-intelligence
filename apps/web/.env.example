# ──────────────────────────────────────────────────────────────────────
# Civic Intelligence — Web app (apps/web) environment variables
# ──────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env.local` (for `next dev`) or set the vars in the
# Vercel project settings (for production). All vars are OPTIONAL — the
# app falls back to mock data when the BFF is unreachable.
#
# ── Backend URLs ──────────────────────────────────────────────────────
#
# API_BASE_URL is the absolute URL of the Go BFF. In dev, defaults to
# http://localhost:9000 (where `docker compose up api` listens). In
# production on Vercel, set this to your Railway / Render / Fly.io URL,
# e.g. https://civic-intelligence-api.up.railway.app.
#
# Used by the Bill detail page, Bill sub-pages (timeline / versions /
# amendments / compare / documents / chat), and the home page.
API_BASE_URL=http://localhost:9000

# API_SERVICE_URL is read by next.config.mjs rewrites. Set to the same
# value as API_BASE_URL. (Without it, the rewrites default to
# http://localhost:9000 which is unreachable from Vercel's serverless
# runtime.)
API_SERVICE_URL=http://localhost:9000

# AI_SERVICE_URL is the base URL of the Python FastAPI service. In dev,
# defaults to http://localhost:8000 (where `docker compose up ai`
# listens). On Vercel, leave UNSET — vercel.json's `services` block
# already routes /api/v1/ai/* to the Python service automatically.
AI_SERVICE_URL=http://localhost:8000

# ── Public URL ────────────────────────────────────────────────────────
#
# NEXT_PUBLIC_SITE_URL is the canonical site URL used for Open Graph,
# canonical link tags, and JSON-LD structured data. In production, set
# this to your Vercel URL or custom domain.
NEXT_PUBLIC_SITE_URL=https://civicintelligence.vercel.app

# ── AI provider keys (only if AI features are enabled) ────────────────
#
# QWEN_API_KEY powers the AI Q&A feature ("Ask about this Bill"). When
# unset, the AI service returns a graceful "AI features unavailable"
# response. The BFF and AI service both need this — set it on the BFF
# (Railway / Render / Fly.io) AND on the Vercel AI service.
# QWEN_API_KEY=ms-...

# ── Optional: OIDC (only if you wire up Keycloak) ─────────────────────
#
# These are read by the Go BFF, not the web app. Listed here for
# reference — set them on the BFF host, not in this file.
# OIDC_ISSUER=http://localhost:8081/realms/civic
# OIDC_AUDIENCE=civic-intelligence
# OIDC_JWKS_URL=http://localhost:8081/realms/civic/protocol/openid-connect/certs

# ── Optional: Postgres (only when switching from in-memory repos) ─────
#
# When unset, the BFF uses in-memory repos with seed data. Set on the
# BFF host (not here) to switch to Postgres-backed repos.
# DATABASE_URL=postgres://civic:civic@localhost:5432/civic?sslmode=disable
