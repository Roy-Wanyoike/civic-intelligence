{
  "name": "civic-intelligence-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test:e2e": "playwright test --config=../../tests/e2e/playwright.config.ts",
    "test:e2e:golden": "playwright test --config=../../tests/e2e/playwright.config.ts --grep=@golden",
    "test:e2e:critical": "playwright test --config=../../tests/e2e/playwright.config.ts --grep=@critical",
    "test:a11y": "playwright test --config=../../tests/e2e/playwright.config.ts --grep=@a11y",
    "test:e2e:ui": "playwright test --config=../../tests/e2e/playwright.config.ts --ui"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.59.16",
    "@types/d3-hierarchy": "^3.1.7",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-force": "^3.0.0",
    "d3-hierarchy": "^3.1.2",
    "html2canvas": "^1.4.1",
    "lucide-react": "^0.454.0",
    "next": "14.2.35",
    "next-intl": "^4.14.5",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.10.1",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.49.0",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.20.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.6.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
