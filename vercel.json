{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "ai": {
      "root": "services/ai"
    }
  },
  "functions": {
    "services/ai/api/index.py": {
      "runtime": "@vercel/python@latest"
    }
  },
  "rewrites": [
    {
      "source": "/api/ai(/.*)?",
      "destination": {
        "type": "service",
        "service": "ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
