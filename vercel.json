{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "ai": {
      "root": "services/ai"
    }
  },
  "rewrites": [
    {
      "source": "/api/ai(/.*)?",
      "destination": {
        "type": "service",
        "service": "ai"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ],
  "crons": [
    {
      "path": "/api/v1/refresh",
      "schedule": "0 3 * * *"
    }
  ]
}
